{
	"compilerOptions": {
		"composite": true,
		"outDir": "out",
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["ES2022", "ESNext.Disposable", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmitOnError": false,
		"noUnusedParameters": true,
		"pretty": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2022",
		"useDefineForClassFields": false,
		"paths": {
			"rollup": ["./node_modules/rollup"]
		}
	},
	"include": ["build-plugins", "typings", "src", "cli", "browser", "rollup.config.ts", "native", "**/*.ts","**/*.json" ],
	"exclude": ["dist", "node_modules", "test/typescript", "browser/dist", "out", "tsconfig.json"]
}
